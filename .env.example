APP_NAME=AI 读书助手
APP_ENV=development
LOG_LEVEL=INFO

# 数据目录相对于项目根目录。
DATA_DIR=data
UPLOAD_MAX_BYTES=20971520
CHUNK_SIZE=300
CHUNK_OVERLAP=50
MAX_CHUNKS_PER_BOOK=10000
INGESTION_BATCH_SIZE=64
RETRIEVAL_CANDIDATES=10

# 本地模型路径相对于项目根目录。
# 如果填写 Hugging Face 模型名，需要同时设置 MODEL_LOCAL_FILES_ONLY=false。
EMBEDDING_MODEL=../rag_mark/models/text2vec-base-chinese
RERANKER_MODEL=../rag_mark/models/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_ENABLED=true
MODEL_LOCAL_FILES_ONLY=true

# auto: 有 GEMINI_API_KEY 时使用 Gemini，否则返回检索摘录。
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.7-flash
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_SECONDS=60

CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
